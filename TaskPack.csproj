<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 커스텀 색 고르기 창(ColorDialog)만 쓴다 -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WFAC010, WFO0003: WinForms 앱용 DPI 안내. 이 앱은 WPF라 app.manifest의 DPI 설정이 맞다 -->
    <NoWarn>$(NoWarn);WFAC010;WFO0003</NoWarn>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TaskPack</AssemblyName>
    <Version>1.2.0</Version>
    <RootNamespace>TaskPack</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- tools\make-icon.ps1 로 만든 서류가방 + 구두 아이콘 -->
    <ApplicationIcon>assets\TaskPack.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- 미리 컴파일해 두어 작업표시줄 아이콘을 누른 뒤 가방이 뜨는 시간을 줄인다 -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- 설치 파일 판: 기본은 .NET을 따로 설치하는 lite, SelfContained로 게시하면 full. 새 버전 알림이 같은 판의 파일을 고르는 데 쓴다 -->
    <TaskPackEdition>lite</TaskPackEdition>
    <TaskPackEdition Condition="'$(SelfContained)' == 'true'">full</TaskPackEdition>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="Edition" Value="$(TaskPackEdition)" />
  </ItemGroup>

  <ItemGroup>
    <!-- 시험 프로젝트(tests\)의 소스는 앱에 넣지 않고, 시험이 internal 클래스를 볼 수 있게 연다 -->
    <Compile Remove="tests\**" />
    <InternalsVisibleTo Include="TaskPack.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pretendard(SIL OFL 1.1)를 exe 안에 넣는다. 라이선스 전문은 assets\fonts\OFL.txt (설치 폴더에도 복사) -->
    <Resource Include="assets\fonts\*.otf" />
    <!-- 탭 아이콘용 이모티콘 그림(Microsoft Fluent Emoji 3D, MIT). 라이선스 전문은 assets\emoji\LICENSE (설치 폴더에도 복사) -->
    <Resource Include="assets\emoji\*.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF와 이름이 겹치는 WinForms 자동 참조는 뺀다 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
