<Window x:Class="TaskPack.ImportDialog"
        FontFamily="{StaticResource AppFont}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="작업표시줄 앱 가져오기"
        Width="380" Height="500" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
        FontSize="13" UseLayoutRounding="True">
    <DockPanel Margin="20,18,20,18">
        <TextBlock DockPanel.Dock="Top" Text="작업표시줄 앱" Style="{StaticResource PageTitle}"/>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageSubtitle}" Margin="0,4,0,12"
                   Text="가방에 둘 앱을 체크하세요. 이미 든 앱은 체크되어 있고, 체크를 풀면 가방에서 빠집니다."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="취소" IsCancel="True" Style="{StaticResource SecondaryButton}" MinWidth="80"/>
            <Button Content="적용" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="80" Margin="8,0,0,0" Click="Ok_Click"/>
        </StackPanel>
        <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Visibility="Collapsed" Style="{StaticResource Note}"
                   Text="작업표시줄에 고정된 앱이 없습니다."/>
        <Border Style="{StaticResource Card}" Padding="4" Margin="0">
            <ListBox x:Name="AppList" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsChecked}" Style="{StaticResource CheckItem}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Icon}" Width="22" Height="22" Margin="0,0,10,0"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
