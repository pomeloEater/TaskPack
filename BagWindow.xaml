<Window x:Class="TaskPack.BagWindow"
        FontFamily="{StaticResource AppFont}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskPack"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True" Topmost="True"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        Left="-10000" Top="-10000"
        UseLayoutRounding="True" FontSize="12">

    <Window.Resources>
        <!-- 색은 Theme.Apply가 테마·가방별 설정에 맞춰 바꾼다 (아래는 다크 기본값) -->
        <SolidColorBrush x:Key="PanelBrush" Color="#FF262626"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#50FFFFFF"/>
        <SolidColorBrush x:Key="SlotBrush" Color="#16FFFFFF"/>
        <SolidColorBrush x:Key="SlotHoverBrush" Color="#30FFFFFF"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#20FFFFFF"/>
        <SolidColorBrush x:Key="SelectedTabBrush" Color="#38FFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF12A594"/>
        <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F0F0F0"/>
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#99FFFFFF"/>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- 가방 한 칸 -->
        <Style x:Key="SlotStyle" TargetType="Border">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="84"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="{DynamicResource SlotBrush}"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SlotHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 탭 -->
        <Style x:Key="TabStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SelectedTabStyle" TargetType="Border" BasedOn="{StaticResource TabStyle}">
            <Setter Property="Background" Value="{DynamicResource SelectedTabBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedTabBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 📌 고정 버튼 -->
        <Style x:Key="PinStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4">
                            <TextBlock x:Name="Glyph" Text="&#xE718;" FontFamily="{StaticResource IconFont}"
                                       FontSize="13" Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SlotHoverBrush}"/>
                            </Trigger>
                            <!-- 켜짐: 강조색 배경 위에 꽉 찬 핀 (배경색과 헷갈리지 않게) -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Glyph" Property="Text" Value="&#xE840;"/>
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ⚙, + 새 가방 같은 글자 버튼 -->
        <Style x:Key="GlyphButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinWidth" Value="26"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SlotHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 빈 가방 안내 버튼, 알림 띠의 [고정하기] 같은 글자 버튼. 기본은 강조색, Subtle 쪽은 은은하게 -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{DynamicResource AccentBrush}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SubtleActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{DynamicResource SlotHoverBrush}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="1" CornerRadius="8" Padding="6,6,6,8" AllowDrop="True">
        <DockPanel>
            <!-- 제목 줄: 빈 곳을 끌면 창이 옮겨진다 -->
            <DockPanel x:Name="HeaderBar" DockPanel.Dock="Top" Margin="0,0,0,6" Background="Transparent"
                       MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown">
                <ToggleButton x:Name="PinButton" DockPanel.Dock="Left" Style="{StaticResource PinStyle}"
                              ToolTip="고정 안 됨: 바깥을 누르면 닫힙니다. 누르면 고정합니다."
                              Checked="PinButton_Changed" Unchecked="PinButton_Changed"/>
                <Button x:Name="SettingsButton" DockPanel.Dock="Right" Style="{StaticResource GlyphButtonStyle}"
                        ToolTip="설정" Click="SettingsButton_Click">
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <StackPanel x:Name="TabPanel" Orientation="Horizontal" Margin="4,0,12,0"/>
            </DockPanel>
            <!-- 알림 띠: 가방 아래에 쌓인다. 너비는 BuildGrid가 칸 너비에 맞춘다 -->
            <StackPanel x:Name="NoticePanel" DockPanel.Dock="Bottom" HorizontalAlignment="Center">
                <Border x:Name="UpdateNotice" Visibility="Collapsed" Margin="0,8,0,0" Padding="10,6,6,6"
                        CornerRadius="6" Background="{DynamicResource SlotBrush}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GlyphButtonStyle}" VerticalAlignment="Center"
                                ToolTip="이 버전은 다시 알리지 않기" Click="DismissUpdateNotice_Click">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource ActionButtonStyle}" Padding="10,3" Margin="6,0,2,0"
                                VerticalAlignment="Center" Content="받기" Click="UpdateNotice_Click"/>
                        <TextBlock x:Name="UpdateNoticeText" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </DockPanel>
                </Border>
                <Border x:Name="PinNotice" Visibility="Collapsed" Margin="0,8,0,0" Padding="10,6,6,6"
                        CornerRadius="6" Background="{DynamicResource SlotBrush}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GlyphButtonStyle}" VerticalAlignment="Center"
                                ToolTip="다시 보지 않기" Click="DismissPinNotice_Click">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource ActionButtonStyle}" Padding="10,3" Margin="6,0,2,0"
                                VerticalAlignment="Center" Content="고정하기" Click="PinNotice_Click"/>
                        <TextBlock Text="작업표시줄에 고정하면 한 번에 열려요" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </DockPanel>
                </Border>
            </StackPanel>
            <Grid>
                <UniformGrid x:Name="SlotGrid" HorizontalAlignment="Center"/>
                <!-- 아이템이 하나도 없는 가방의 안내. 배경이 없어서 버튼 밖은 빈칸이 파일 끌어놓기·우클릭을 그대로 받는다 -->
                <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Style="{StaticResource ActionButtonStyle}" Content="작업표시줄 앱 가져오기" Click="EmptyImport_Click"/>
                    <Button Style="{StaticResource SubtleActionButtonStyle}" Content="파일로 넣기" Margin="0,6,0,0" Click="EmptyAddFiles_Click"/>
                    <TextBlock Text="파일을 끌어다 놓아도 돼요 (📌을 켜 두세요)" Margin="0,8,0,0" FontSize="11"
                               HorizontalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}"/>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
