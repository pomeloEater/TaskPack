<Window x:Class="TaskPack.SettingsWindow"
        FontFamily="{StaticResource AppFont}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskPack 설정"
        Width="840" Height="570" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
        FontSize="13" UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 왼쪽 메뉴 -->
        <Border Grid.Column="0" Background="{DynamicResource SlotBrush}">
            <DockPanel Margin="12,18,12,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,20">
                    <Image x:Name="AppIconImage" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="TaskPack" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <Button DockPanel.Dock="Bottom" Content="닫기" Style="{StaticResource SecondaryButton}"
                        IsCancel="True" Click="Close_Click"/>
                <StackPanel>
                    <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE713;" Content="기본 설정" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavBags" Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE7B8;" Content="가방" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavBackup" Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE74E;" Content="백업" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28,22,28,20">
            <!-- 가방 -->
            <DockPanel x:Name="BagsPage" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="가방" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="가방(탭)마다 이름, 테마와 색, 크기, 아이콘을 정합니다."
                               Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0" Margin="0,0,16,0">
                        <Button DockPanel.Dock="Bottom" Content="+ 새 가방" Style="{StaticResource SecondaryButton}"
                                Margin="0,8,0,0" Click="AddBag_Click"/>
                        <ListBox x:Name="BagList" Style="{StaticResource CardList}" SelectionChanged="BagList_SelectionChanged"/>
                    </DockPanel>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="BagDetail" Margin="0,0,10,0">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="이름" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="NameBox" Style="{StaticResource InputBox}"
                                             KeyDown="NameBox_KeyDown" LostKeyboardFocus="NameBox_LostKeyboardFocus"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="테마" Style="{StaticResource FieldLabel}"/>
                                    <Border Style="{StaticResource SegmentGroup}">
                                        <StackPanel x:Name="ModePanel" Orientation="Horizontal"/>
                                    </Border>
                                    <StackPanel x:Name="ColorSection" Margin="0,14,0,0">
                                        <TextBlock Text="가방 색" Style="{StaticResource FieldLabel}"/>
                                        <WrapPanel x:Name="SwatchPanel"/>
                                        <Button Content="다른 색 고르기…" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                                Margin="0,4,0,0" Padding="12,6" Click="OtherColor_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="크기" Style="{StaticResource FieldLabel}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="가로" VerticalAlignment="Center" Width="34"/>
                                        <Button Content="−" Style="{StaticResource StepButton}" Click="ColumnsMinus_Click"/>
                                        <TextBlock x:Name="ColumnsText" Width="36" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="15"/>
                                        <Button Content="+" Style="{StaticResource StepButton}" Click="ColumnsPlus_Click"/>
                                        <TextBlock Text="세로" VerticalAlignment="Center" Width="34" Margin="28,0,0,0"/>
                                        <Button Content="−" Style="{StaticResource StepButton}" Click="RowsMinus_Click"/>
                                        <TextBlock x:Name="RowsText" Width="36" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="15"/>
                                        <Button Content="+" Style="{StaticResource StepButton}" Click="RowsPlus_Click"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Note}"
                                               Text="줄이면 밖으로 나가는 아이템은 빈칸으로 옮깁니다. 아이템보다 칸이 적어지면 줄이지 않습니다."/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="탭 아이콘" Style="{StaticResource FieldLabel}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="TabIconPreview" Width="44" Height="44" CornerRadius="8" Background="{DynamicResource SlotHoverBrush}" Margin="0,0,12,0"/>
                                        <Button x:Name="TabIconRemoveButton" Content="삭제" Style="{StaticResource SecondaryButton}" Padding="12,6"
                                                VerticalAlignment="Center" Click="TabIconRemove_Click"/>
                                    </StackPanel>
                                    <WrapPanel x:Name="EmojiPanel" Margin="0,12,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="직접 입력" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox x:Name="EmojiInput" Width="64" Padding="6,4" FontFamily="Segoe UI Emoji, Segoe UI Symbol"
                                                 VerticalContentAlignment="Center" KeyDown="EmojiInput_KeyDown"/>
                                        <Button Content="넣기" Style="{StaticResource SecondaryButton}" Padding="12,5" Margin="6,0,0,0" Click="EmojiApply_Click"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Note}"
                                               Text="목록에 없는 이모티콘은 Win + . 키로 입력하세요. 컬러 글꼴을 그릴 수 없어 탭 글자색 한 가지로 보입니다."/>
                                    <Button x:Name="TabIconButton" Content="그림 파일에서 고르기…" Style="{StaticResource SecondaryButton}" Padding="12,6"
                                            HorizontalAlignment="Left" Margin="0,12,0,0" Click="TabIcon_Click"/>
                                    <CheckBox x:Name="HideNameSwitch" Style="{StaticResource Switch}" Margin="0,14,0,0"
                                              Content="탭에 이름을 숨기고 아이콘만 보이기" Click="HideName_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </DockPanel>

            <!-- 기본 설정: 작업표시줄 아이콘 + 화면 -->
            <ScrollViewer x:Name="GeneralPage" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="기본 설정" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="작업표시줄에 고정하는 가방 아이콘과 모든 가방의 기본 테마를 정합니다." Style="{StaticResource PageSubtitle}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="72" Height="72" CornerRadius="12" Background="{DynamicResource SlotHoverBrush}" Margin="0,0,16,0">
                                <Image x:Name="DrawerIconImage" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="작업표시줄 아이콘" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="아이콘 바꾸기…" Style="{StaticResource SecondaryButton}" Padding="12,6" Click="ChangeDrawerIcon_Click"/>
                                    <Button x:Name="ResetDrawerIconButton" Content="기본 아이콘" Style="{StaticResource SecondaryButton}" Padding="12,6"
                                            Margin="6,0,0,0" Click="ResetDrawerIcon_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="작업표시줄 고정" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="PinnedText" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <Button Content="작업표시줄에 고정하기…" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="Pin_Click"/>
                            <TextBlock Style="{StaticResource Note}"
                                       Text="Windows는 프로그램이 스스로 고정하는 것을 막습니다. 시작 메뉴에 바로가기를 만들어 드리면, 우클릭 → '작업 표시줄에 고정'을 눌러 주세요."/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="전체 테마" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource SegmentGroup}">
                                <StackPanel x:Name="GlobalModePanel" Orientation="Horizontal"/>
                            </Border>
                            <TextBlock Style="{StaticResource Note}"
                                       Text="모든 가방의 기본 테마입니다. 가방 페이지에서 가방마다 따로 정한 테마가 있으면 그쪽을 따릅니다."/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="마우스를 올리면 열기" Style="{StaticResource FieldLabel}"/>
                            <CheckBox x:Name="HoverSwitch" Style="{StaticResource Switch}"
                                      Content="작업표시줄 아이콘에 마우스를 올리면 가방 열기" Click="Hover_Click"/>
                            <TextBlock Text="머무는 시간" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                            <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left">
                                <StackPanel x:Name="HoverDelayPanel" Orientation="Horizontal"/>
                            </Border>
                            <TextBlock x:Name="HoverUnsupportedText" Style="{StaticResource Note}" Visibility="Collapsed"
                                       Text="이 PC의 작업표시줄에서는 TaskPack 아이콘을 찾지 못해 지원하지 않습니다. 작업표시줄에 TaskPack을 고정한 Windows 11 기본 작업표시줄에서 동작합니다."/>
                            <CheckBox x:Name="AutostartSwitch" Style="{StaticResource Switch}" Margin="0,12,0,0"
                                      Content="Windows를 시작할 때 TaskPack 켜 두기" Click="Autostart_Click"/>
                            <TextBlock x:Name="AutostartNote" Style="{StaticResource Note}" Visibility="Collapsed"/>
                            <TextBlock Style="{StaticResource Note}"
                                       Text="켜면 TaskPack이 뒤에서 계속 켜져 있고(메모리 약 10MB), 시계 옆에 아이콘이 생깁니다. 아이콘 위에 정한 시간(기본 0.4초) 머물면 가방이 열리고, 마우스가 떠나면 닫힙니다. 너무 짧으면 지나가다 스칠 때도 열릴 수 있습니다. 마우스 위치는 아이콘 위인지 판단하는 데만 쓰고 저장하거나 보내지 않습니다."/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="버전" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="CurrentVersionText" TextWrapping="Wrap"/>
                            <TextBlock x:Name="LatestVersionText" TextWrapping="Wrap" Margin="0,4,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="CheckUpdateButton" Content="지금 확인" Style="{StaticResource SecondaryButton}" Padding="12,6"
                                        Click="CheckUpdate_Click"/>
                                <Button x:Name="GetUpdateButton" Content="받기" Style="{StaticResource PrimaryButton}" Padding="12,6"
                                        Margin="6,0,0,0" Visibility="Collapsed" Click="GetUpdate_Click"/>
                            </StackPanel>
                            <CheckBox x:Name="AutoUpdateSwitch" Style="{StaticResource Switch}" Margin="0,14,0,0"
                                      Content="새 버전 자동 확인" Click="AutoUpdate_Click"/>
                            <TextBlock Style="{StaticResource Note}"
                                       Text="가방을 열 때 하루에 한 번, GitHub 공개 주소에서 최신 버전 정보만 읽어 옵니다. 보내는 정보는 없습니다."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <!-- 백업 -->
            <StackPanel x:Name="BackupPage" Visibility="Collapsed">
                <TextBlock Text="백업" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="모든 가방의 칸, 탭 아이콘, 작업표시줄 아이콘을 zip 파일 하나로 저장하고 되살립니다."
                           Style="{StaticResource PageSubtitle}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="내보내기" Style="{StaticResource FieldLabel}"/>
                        <Button Content="백업 내보내기…" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="Export_Click"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="불러오기" Style="{StaticResource FieldLabel}"/>
                        <Button Content="백업 불러오기…" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="Import_Click"/>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="지금 가방이 모두 백업 내용으로 바뀝니다. 지금 상태는 TaskPack 폴더의 restore-backup 폴더에 따로 보관합니다. 작업표시줄 고정은 다른 PC에서 다시 해야 합니다."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
